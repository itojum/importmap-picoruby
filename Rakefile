# `rake build` writes loader.rb, the single file users load with
# <script type="text/ruby" src=".../loader.rb">. PicoRuby.wasm starts with an
# empty file system, so the loader cannot require its own parts: the build
# puts lib/loader.rb and every file it pulls in with require_relative into one file.

require "rspec/core/rake_task"

ENTRY = File.expand_path("lib/loader.rb", __dir__)
OUTPUT = File.expand_path("loader.rb", __dir__)

def bundle_source(path, seen = {})
  return "" if seen[path]
  seen[path] = true
  File.read(path).gsub(/^require_relative "([^"]+)"\n/) do
    bundle_source(File.expand_path("#{$1}.rb", File.dirname(path)), seen)
  end
end

desc "Build loader.rb from lib/"
task :build do
  source = bundle_source(ENTRY)
  header = "# This file is generated by `rake build` from lib/. Do not edit it.\n"
  File.write(OUTPUT, source.sub(/\A((?:#.*\n)+)/) { "#{$1}#\n#{header}" })
  puts "wrote #{File.basename(OUTPUT)} (#{source.lines.size} lines)"
end

RSpec::Core::RakeTask.new(:spec)

task default: :spec
